PORT=8080

# OpenAI
OPENAI_API_KEY=sk-proj-reemplazar
OPENAI_MODEL=gpt-5.4-mini

# BigQuery
GCP_PROJECT=ux-bid-bot
BQ_DATASET=ux_research
BQ_TABLE=ux_clean_final

# Vercel / produccion:
# Pega aqui el JSON completo de la service account en una sola linea,
# o en base64. No subas el archivo JSON al repositorio.
GOOGLE_CREDENTIALS_JSON=
CORS_ORIGIN=*

# Autenticacion local de Google Cloud:
# Opcion A: ejecutar `gcloud auth application-default login`
# Opcion B: apuntar a un service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\service-account.json
